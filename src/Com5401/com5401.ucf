# strap-in configuration. Micrel KSZ9021RN
# advertise all capabilities: 10/100/1000
NET "RXD<3>" PULLUP ;
NET "RXD<2>" PULLUP ;
NET "RXD<1>" PULLUP ;
NET "RXD<0>" PULLUP ;
# enable 125 MHz clock reference to FPGA (at least for one PHY, not needed for all PHYs)
NET "RX_CTL" PULLUP;
# dual LED mode
NET "CLK125_NDO" PULLDOWN;
# PHYAD2   This PHY address is 4
NET "RXC" PULLUP;
# repeat the code above for each PHY


# COM-1600 interface with COM-5401
# PHY#1
NET "RXC" LOC = "C9";
NET "RX_CTL" LOC = "D9";
NET "RXD<0>" LOC = "F9";
NET "RXD<1>" LOC = "G9";
NET "RXD<2>" LOC = "A11";
NET "RXD<3>" LOC = "B11";
NET "TXC" LOC = "F10";
NET "TX_CTL" LOC = "G11";
NET "TXD<0>" LOC = "A12";
NET "TXD<1>" LOC = "B12";
NET "TXD<2>" LOC = "E11";
NET "TXD<3>" LOC = "F11";
NET "CLK125_NDO" LOC = "C12";
NET "INT_N" LOC = "D12";
NET "RESET_N" LOC = "A13";
NET "MCLK" LOC = "C13";
NET "MDIO" LOC = "E12";

